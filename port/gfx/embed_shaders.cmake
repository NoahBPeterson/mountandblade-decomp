# port/gfx/embed_shaders.cmake: turns shaders/*.hlsl into C++ string constants (gfx_shader_sources.h) so the library
# carries its shader sources; glslang compiles them at run time (and the shader cache keeps the results).
#   cmake -DDIR=<shaders dir> -DOUT=<header> -P embed_shaders.cmake
file(GLOB files "${DIR}/*.hlsl")
list(SORT files)
set(text "// generated by port/gfx/embed_shaders.cmake from port/gfx/shaders/*.hlsl; do not edit\n#pragma once\n")
foreach(f ${files})
  get_filename_component(n "${f}" NAME_WE)
  file(READ "${f}" body)
  string(APPEND text "static const char k_src_${n}[] = R\"MBGSRC(\n${body})MBGSRC\";\n")
endforeach()
file(WRITE "${OUT}.tmp" "${text}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
